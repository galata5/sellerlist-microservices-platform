PUBLIC_HOST=localhost
PUBLIC_HTTP_PORT=18080
PUBLIC_HTTPS_PORT=18443
GRAFANA_PORT=3001
FRONTEND_ORIGIN=https://localhost:18443
# Optional for local Compose only. The frontend defaults to same-origin /api when unset.
NEXT_PUBLIC_API_URL=https://localhost:18443
JWT_SECRET=replace-with-a-long-random-secret-with-at-least-32-characters
USER_SERVICE_INTERNAL_AUTH_SECRET=replace-with-a-unique-user-service-secret
PRODUCT_SERVICE_INTERNAL_AUTH_SECRET=replace-with-a-unique-product-service-secret
ORDER_SERVICE_INTERNAL_AUTH_SECRET=replace-with-a-unique-order-service-secret
PAYMENT_SERVICE_INTERNAL_AUTH_SECRET=replace-with-a-unique-payment-service-secret
SHIPPING_SERVICE_INTERNAL_AUTH_SECRET=replace-with-a-unique-shipping-service-secret
FAVOURITE_SERVICE_INTERNAL_AUTH_SECRET=replace-with-a-unique-favourite-service-secret
SECURE_COOKIES=true
MYSQL_ROOT_PASSWORD=change-root-password
GRAFANA_ADMIN_USER=sellerlist-admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
RABBITMQ_USERNAME=sellerlist
RABBITMQ_PASSWORD=replace-with-a-strong-rabbitmq-password

# User service database
USER_SERVICE_DB_URL=jdbc:mysql://mysql:3306/user_service?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
USER_SERVICE_DB_USER=user_service
USER_SERVICE_DB_PASSWORD=change-me

# Product service database
PRODUCT_SERVICE_DB_URL=jdbc:mysql://mysql:3306/product_service?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
PRODUCT_SERVICE_DB_USER=product_service
PRODUCT_SERVICE_DB_PASSWORD=change-me

# Order service database
ORDER_SERVICE_DB_URL=jdbc:mysql://mysql:3306/order_service?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
ORDER_SERVICE_DB_USER=order_service
ORDER_SERVICE_DB_PASSWORD=change-me

# Payment service database
PAYMENT_SERVICE_DB_URL=jdbc:mysql://mysql:3306/payment_service?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
PAYMENT_SERVICE_DB_USER=payment_service
PAYMENT_SERVICE_DB_PASSWORD=change-me

# Shipping service database
SHIPPING_SERVICE_DB_URL=jdbc:mysql://mysql:3306/shipping_service?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SHIPPING_SERVICE_DB_USER=shipping_service
SHIPPING_SERVICE_DB_PASSWORD=change-me

# Favourite service database
FAVOURITE_SERVICE_DB_URL=jdbc:mysql://mysql:3306/favourite_service?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
FAVOURITE_SERVICE_DB_USER=favourite_service
FAVOURITE_SERVICE_DB_PASSWORD=change-me

